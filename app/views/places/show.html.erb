<h1>
  <%= @place["name"] %>
</h1>

<p>
  <a href="/places">Back to Places</a>
</p>

<p>
  <a href="/entries/new?place_id=<%= @place["id"] %>">
    New Entry
  </a>
</p>

<% for entry in @place.entries %>

  <h2>
    <%= entry["title"] %>
  </h2>

  <p>
    <%= entry["occurred_on"] %>
  </p>

  <p>
    <%= entry["description"] %>
  </p>

<% end %>